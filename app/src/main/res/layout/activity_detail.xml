<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".DetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top empty area on the main page maps to: the input time + current h/m/s line. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="220dp"
            android:layout_weight="2.2"
            android:background="@drawable/box_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="姓名" />

            <TextView
                android:id="@+id/detailTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                tools:text="2024-05-20 14:30:00" />

            <TextView
                android:id="@+id/detailCurrentTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                tools:text="当前：13:45:00" />
        </LinearLayout>

        <!-- 年月日 differences -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/box_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/detailDiff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="已过 1 年 2 月 19 天" />

            <TextView
                android:id="@+id/detailTotalDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                tools:text="合计 569 天" />
        </LinearLayout>

        <Button
            android:id="@+id/detailEditButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/box_bg"
            android:padding="14dp"
            android:stateListAnimator="@null"
            android:text="编辑"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
