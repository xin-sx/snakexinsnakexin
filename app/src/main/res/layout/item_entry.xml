<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginVertical="6dp"
    android:background="@drawable/box_bg">

    <!-- Top narrow strip: name -->
    <TextView
        android:id="@+id/itemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="姓名" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/box_outline" />

    <!-- Bottom area: time -->
    <TextView
        android:id="@+id/itemTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        tools:text="2024-05-20 14:30:00" />

    <!-- 完整句子：某某某 至今有 X 年 X 个月零 X 天零 X 小时 X 秒（模值，跳过分，秒级跳动） -->
    <TextView
        android:id="@+id/itemSentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="师兄 至今有 24 年 7 个月零 5 天零 13 小时 52 秒" />

</LinearLayout>
